# STAGING settings: the template for /opt/carlink-staging/infra/.env on the
# server (chmod 600; git-ignored; compose reads it because infra/ is the
# project folder). Names only for the secrets -- never put a value in this
# file. infra/README.md "Staging" has the setup steps.
#
# (Named staging.env.example, not .env.staging.example: .gitignore and the CI
# guard block .env.* files, so a template there could never be committed.)

# --- who this stack is (deploy.sh refuses anything else) -------------------
COMPOSE_PROJECT_NAME=carlink-staging
CARLINK_NAME=carlink_staging
NGINX_BIND=127.0.0.1
NGINX_PORT=8081
PUBLIC_BASE_URL=https://carlink-staging.34-16-92-98.sslip.io

# --- secrets (values only in the server's infra/.env) ----------------------
# The SAME Gemini key as production (owner decision 22 Nov: one key, shared
# quota, production first -- see the shared AI folder below). Copied from the
# running production container without printing it (README "Staging" step 2).
GEMINI_API_KEY=
# Empty = no Telegram bot. When a pull request touches the bot: a separate
# TEST bot's token (@BotFather), never production's (deploy.sh refuses it),
# plus COMPOSE_PROFILES=telegram below.
TELEGRAM_BOT_TOKEN=
# Only with COMPOSE_PROFILES=catalogue (catalogue pull requests): its own
# token, never production's.
CATALOGUE_ENABLED=false
CATALOGUE_WORKER_TOKEN=

# --- optional containers: "telegram", "catalogue" or both (comma) ----------
COMPOSE_PROFILES=

# --- the shared AI quota folder on the host (docker-compose.ai-shared.yml) -
CARLINK_AI_SHARED_DIR=/opt/carlink-ai-shared
# The staging lane's limits (app/config.py defaults; uncomment to change):
# GEMINI_STAGING_MAX_PER_MINUTE=4
# GEMINI_STAGING_WINDOW_SHARE=6
# GEMINI_STAGING_DAY_MAX=300
# GEMINI_STAGING_MODEL_RESERVE=300
# GEMINI_STAGING_PROD_BUSY=400
# GEMINI_QUOTA_DAY_LIMITS=gemini-3.5-flash-lite=500,gemini-3.1-flash-lite=500

# --- feature flags: the same as production's, then the PR's new ones ------
# Copy production's flag lines (no secrets in them) below, then change only
# what the pull request asks for (its "flags list", sandbox gate D):
#   grep -E '^(GEMINI_(MODEL|TRIAGE|ZONE|LINK|CHECK|READ|THINKING|IMAGE|SECOND)[A-Z_]*|INTAKE_[A-Z_]+|TELEGRAM_FULL_DETECTION)=' \
#     /opt/carlink-system/infra/.env >> /opt/carlink-staging/infra/.env
# deploy.sh --env staging prints every flag that differs from production's.
